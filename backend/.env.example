# Supabase (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
# Use the service role key for the backend (keeps RLS from blocking the API)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Optional fallback (not recommended for production)
SUPABASE_KEY=your_anon_key_here

# Mistral AI
MISTRAL_API_KEY=your_mistral_api_key

# JWT (generate a long random string)
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Gmail SMTP (Google Account → App Passwords)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# Optional: secret for scheduled reminder endpoints
CRON_SECRET=change_me_for_task_scheduler

APP_NAME=Regrowth OS
FRONTEND_URL=http://localhost:3000
